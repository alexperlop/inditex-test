{
  "name": "inditex-test",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "axios": "1.20.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.5.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.4",
    "cypress": "16.1.0",
    "eslint": "9.36.0",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.6.0",
    "msw": "2.11.5",
    "prettier": "3.9.9",
    "sass": "1.105.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  },
  "overrides": {
    "vite": "7.3.6"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,scss,css}": [
      "prettier --write"
    ]
  }
}
